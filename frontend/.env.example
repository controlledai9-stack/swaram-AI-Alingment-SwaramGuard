# Copy to frontend/.env.local (never commit .env.local). Leave empty to run without sign-in (local mode).
# Firebase console -> Project settings -> Your apps -> Add app -> Web (</>) -> copy these four values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# "How to use" video in the History sidebar (a YouTube link).
VITE_HOW_TO_VIDEO_URL=
